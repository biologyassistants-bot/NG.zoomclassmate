# Copy this to .env (or set these in your host's dashboard) before deploying.

# Required in production: an OpenAI-compatible API key powers the answers & quizzes.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Optional: which model to use (default gpt-4o-mini — cheap and good for this).
OPENAI_MODEL=gpt-4o-mini

# Optional: point at a different OpenAI-compatible endpoint (e.g. Azure, Groq, local).
# OPENAI_BASE_URL=https://api.openai.com/v1
